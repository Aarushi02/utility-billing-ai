# Docker Compose template
# Copy to .env.docker and fill values. Do not commit secrets.

PROJECT_NAME=utility_billing_ai
ENV=docker
LOG_LEVEL=INFO

# App auth
LOGIC_USERNAME=admin
LOGIC_PASSWORD=change_me
SECRET_KEY=change_me

# App DB config (external managed Postgres)
DB_TYPE=postgres
DB_HOST=<managed-db-host>
DB_PORT=5432
DB_NAME=<db-name>
DB_USER=<db-user>
DB_PASSWORD=<db-password>

# Streamlit -> API (compose service DNS)
API_BASE_URL=http://api:8000

# API -> Airflow (compose service DNS)
AIRFLOW_API_URL=http://airflow:8080/api/v2
AIRFLOW_API_USER=admin
AIRFLOW_API_PASSWORD=change_me
AIRFLOW_DAG_ID=utility_billing_pipeline

# Airflow container settings
AIRFLOW_UID=50000
AIRFLOW_GID=0
AIRFLOW__WEBSERVER__SECRET_KEY=change_me
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2://<db-user>:<db-password>@<managed-db-host>:5432/<airflow-db-name>

# LLM
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# AWS
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_BUCKET_NAME=utility-billing-storage
AWS_REGION=us-east-1
