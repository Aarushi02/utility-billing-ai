# Production template
# Copy to .env.prod in your server/secret manager. Do not commit secrets.

PROJECT_NAME=utility_billing_ai
ENV=prod
LOG_LEVEL=INFO

# App auth
LOGIC_USERNAME=admin
LOGIC_PASSWORD=change_me
SECRET_KEY=change_me

# Managed DB (RDS/Azure/GCP)
DB_TYPE=postgres
DB_HOST=<managed-db-host>
DB_PORT=5432
DB_NAME=<db-name>
DB_USER=<db-user>
DB_PASSWORD=<db-password>

# Frontend -> Backend public URL
API_BASE_URL=https://api.yourdomain.com

# Backend -> Airflow internal/private URL
AIRFLOW_API_URL=http://airflow.internal:8080/api/v2
AIRFLOW_API_USER=<airflow-user>
AIRFLOW_API_PASSWORD=<airflow-password>
AIRFLOW_DAG_ID=utility_billing_pipeline

# LLM
OPENAI_API_KEY=<openai-key>
OPENAI_MODEL=gpt-4.1-mini

# AWS
AWS_ACCESS_KEY_ID=<aws-access-key-id>
AWS_SECRET_ACCESS_KEY=<aws-secret-access-key>
AWS_BUCKET_NAME=utility-billing-storage
AWS_REGION=us-east-1

# Optional CORS for API service
CORS_ORIGINS=https://app.yourdomain.com
