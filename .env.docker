# Docker runtime environment for docker-compose services
# Safe defaults for local Docker. Replace change_me values before real use.

PROJECT_NAME=utility_billing_ai
ENV=docker
LOG_LEVEL=INFO

LOGIC_USERNAME=admin
LOGIC_PASSWORD=change_me
SECRET_KEY=change_me

POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me
POSTGRES_DB=utility_billing_db

DB_TYPE=postgres
DB_HOST=postgres
DB_PORT=5432
DB_NAME=utility_billing_db
DB_USER=postgres
DB_PASSWORD=change_me

API_BASE_URL=http://api:8000

AIRFLOW_API_URL=http://airflow:8080/api/v2
AIRFLOW_API_USER=admin
AIRFLOW_API_PASSWORD=change_me
AIRFLOW_DAG_ID=utility_billing_pipeline
AIRFLOW_UID=50000
AIRFLOW_GID=0
AIRFLOW__WEBSERVER__SECRET_KEY=change_me

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_BUCKET_NAME=utility-billing-storage
AWS_REGION=us-east-1
