# Local (venv) template
# Copy to .env.local and fill values. Do not commit secrets.

PROJECT_NAME=utility_billing_ai
ENV=local
LOG_LEVEL=INFO

# App auth
LOGIC_USERNAME=admin
LOGIC_PASSWORD=change_me
SECRET_KEY=change_me

# Database (local direct connection)
DB_TYPE=postgres
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=utility_billing_db
DB_USER=postgres
DB_PASSWORD=change_me

# Streamlit -> API
API_BASE_URL=http://127.0.0.1:8000

# API -> Airflow
AIRFLOW_API_URL=http://127.0.0.1:8080/api/v2
AIRFLOW_API_USER=admin
AIRFLOW_API_PASSWORD=change_me
AIRFLOW_DAG_ID=utility_billing_pipeline

# LLM
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# AWS
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_BUCKET_NAME=utility-billing-storage
AWS_REGION=us-east-1
