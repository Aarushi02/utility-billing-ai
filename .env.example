# ============================================
# THE AGENTIC AUDITOR - Environment Variables
# ============================================
# Copy this file to .env and fill in your values

# ============================================
# APPLICATION SETTINGS
# ============================================
APP_NAME=The Agentic Auditor
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

# ============================================
# STREAMLIT CONFIGURATION
# ============================================
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=localhost
STREAMLIT_LOGGER_LEVEL=info

# ============================================
# AUTHENTICATION
# ============================================
# Default credentials for login
LOGIC_USERNAME=admin
LOGIC_PASSWORD=secure_password_here
SECRET_KEY=your-super-secret-key-change-in-production

# JWT Configuration
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# ============================================
# DATABASE CONFIGURATION
# ============================================
# PostgreSQL RDS Connection
DB_HOST=localhost
DB_PORT=5432
DB_NAME=utility_billing_db
DB_USER=postgres
DB_PASSWORD=your_secure_database_password
DATABASE_URL=postgresql://postgres:your_secure_database_password@localhost:5432/utility_billing_db

# SQLAlchemy settings
SQLALCHEMY_ECHO=false
SQLALCHEMY_POOL_SIZE=10
SQLALCHEMY_POOL_RECYCLE=3600

# ============================================
# AWS CONFIGURATION
# ============================================
# AWS Credentials
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=us-east-1

# S3 Configuration
S3_BUCKET_NAME=utility-billing-ai-bucket
S3_RAW_DATA_PREFIX=raw_data/
S3_PROCESSED_DATA_PREFIX=processed_data/
S3_REPORTS_PREFIX=reports/

# ============================================
# OPENAI CONFIGURATION
# ============================================
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
OPENAI_TEMPERATURE=0.7
OPENAI_MAX_TOKENS=2000

# ============================================
# AIRFLOW CONFIGURATION
# ============================================
# Airflow Home and Core Settings
AIRFLOW_HOME=/path/to/airflow
AIRFLOW__CORE__DAGS_FOLDER=/path/to/airflow/dags
AIRFLOW__CORE__BASE_LOG_FOLDER=/path/to/airflow/logs
AIRFLOW__CORE__EXECUTOR=LocalExecutor

# Airflow Database
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2://postgres:password@localhost:5432/airflow

# Airflow Webserver
AIRFLOW__WEBSERVER__BASE_URL=http://localhost:8080
AIRFLOW__WEBSERVER__SECRET_KEY=your-airflow-secret-key
AIRFLOW__WEBSERVER__PORT=8080

# Airflow Core
AIRFLOW__CORE__LOAD_EXAMPLES=False
AIRFLOW__CORE__LOAD_DEFAULT_CONNECTIONS=False
AIRFLOW__CORE__DAGS_ARE_PAUSED_AT_CREATION=False

# DAG Defaults
AIRFLOW__CORE__DAG_DEFAULT_VIEW=graph
AIRFLOW__CORE__MAX_ACTIVE_TASKS_PER_DAG=10
AIRFLOW__CORE__MAX_ACTIVE_RUNS_PER_DAG=1

# ============================================
# FILE PATHS
# ============================================
# Local file storage paths
DATA_DIR=./data
INCOMING_DIR=./data/incoming
RAW_DIR=./data/raw
PROCESSED_DIR=./data/processed
OUTPUT_DIR=./data/output
SAMPLES_DIR=./data/samples

# Log files
LOG_DIR=./logs
APP_LOG_FILE=./logs/app.log
ERROR_LOG_FILE=./logs/error.log

# ============================================
# PDF PROCESSING
# ============================================
# PDF Extraction Settings
PDF_MAX_PAGES=100
PDF_EXTRACT_TABLES=true
PDF_EXTRACT_TEXT=true
PDF_DPI=150
PDF_TIMEOUT_SECONDS=300

# ============================================
# BILL VALIDATION
# ============================================
# Validation Thresholds
OVERCHARGE_THRESHOLD_PERCENT=0.5
MIN_USAGE_THRESHOLD=0
MAX_USAGE_THRESHOLD=10000
ERROR_DETECTION_SENSITIVITY=0.8

# ============================================
# EMAIL CONFIGURATION
# ============================================
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SENDER_EMAIL=utility-auditor@company.com
ADMIN_EMAIL=admin@company.com

# ============================================
# REPORT GENERATION
# ============================================
# Report Settings
REPORT_FORMAT=pdf
REPORT_INCLUDE_CHARTS=true
REPORT_INCLUDE_CALCULATIONS=true
REPORT_THEME=default

# ============================================
# MONITORING & LOGGING
# ============================================
# Logging Configuration
LOGGING_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s
LOGGING_DATE_FORMAT=%Y-%m-%d %H:%M:%S

# Sentry (Error Tracking) - Optional
SENTRY_DSN=

# ============================================
# SECURITY
# ============================================
# CORS Settings
CORS_ORIGINS=http://localhost:3000,http://localhost:8501
CORS_CREDENTIALS=true
CORS_METHODS=GET,POST,PUT,DELETE
CORS_HEADERS=*

# ============================================
# DOCKER CONFIGURATION
# ============================================
# Docker Compose
DOCKER_REGISTRY=docker.io
PYTHON_VERSION=3.10

# ============================================
# DEVELOPMENT SETTINGS
# ============================================
# Development only - do not use in production
ENABLE_TESTING=false
TEST_MODE=false
SAMPLE_DATA_ENABLED=true

# ============================================
# PRODUCTION SETTINGS
# ============================================
# Set these when deploying to production
PRODUCTION=false
ENABLE_HTTPS=false
SSL_CERT_PATH=/path/to/cert.pem
SSL_KEY_PATH=/path/to/key.pem

# ============================================
# FEATURE FLAGS
# ============================================
ENABLE_LLM_ANALYSIS=true
ENABLE_REAL_TIME_MONITORING=false
ENABLE_BATCH_PROCESSING=true
ENABLE_EMAIL_NOTIFICATIONS=false
