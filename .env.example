# Core app
ENV=prod
LOG_LEVEL=INFO
PROJECT_NAME=utility_billing_ai

# Streamlit authentication
LOGIC_USERNAME=change_me
LOGIC_PASSWORD=change_me

# Streamlit -> API routing
# Use http://127.0.0.1:8000 for non-Docker local runs.
# Use http://api:8000 for Docker Compose.
API_BASE_URL=http://api:8000

# Database
DB_TYPE=postgres
DB_HOST=your-db-host
DB_PORT=5432
DB_NAME=your-db-name
DB_USER=your-db-user
DB_PASSWORD=your-db-password
DB_PATH=data/project.db

# Optional LLM
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional S3
AWS_BUCKET_NAME=utility-billing-data
AWS_REGION=us-east-1
# Prefer IAM role in production. Only set keys if needed.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Legacy AWS key names (backward compatibility, leave blank unless required)
aws_access_key_id=
Secret_access_key=

# Optional Airflow integration (not used in current two-service deployment)
AIRFLOW_API_URL=http://localhost:8080/api/v2
AIRFLOW_API_USER=admin
AIRFLOW_API_PASSWORD=admin
AIRFLOW_DAG_ID=utility_billing_pipeline
